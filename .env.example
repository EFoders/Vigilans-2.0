# Copy to .env (git-ignored). A real environment variable always wins over this file.
# Every value here has a flag of the same name: VIGILANS_RATE <-> --rate.
# Comments go on their own lines: a trailing "# ..." would become part of the value.

# VIGILANS_CONFIG=vigilans.toml
# VIGILANS_SCENARIO=mixed
# VIGILANS_FILES=out/a.observations.jsonl,out/b.observations.jsonl
# VIGILANS_SEED=1

# Picture seconds per wall second; "max" runs offline.
# VIGILANS_RATE=1

# HOST:PORT for the picture feed; "none" serves nothing.
# VIGILANS_LISTEN=127.0.0.1:8091

# VIGILANS_RECORD=out/run.picture.jsonl

# Private libraries live OUTSIDE the repository (the loader refuses one inside it).
# VIGILANS_LIBRARY=/secure/libraries/site.yaml

# VIGILANS_RUN_ID=
# VIGILANS_DURATION_S=
